# Google Sheet this worker targets.
SPREADSHEET_ID=1KJOTaAyWy5k5ioRvMEf3wmPW82Z40H7U5qE_5QNCII4

# Data tab holding Mobile Number/Name/Status/Modified/Active.
# Defaults to a test tab on purpose - switch to Sheet1 yourself once verified.
TEST_TAB_NAME=Sheet1_Test

# Tab names for the existing live control panel and audit log (usually leave as-is).
CONTROL_TAB_NAME=Automation Control
LOG_TAB_NAME=Execution Log

# Path to the service-account JSON credential. Keep this file outside the repo
# if possible, or at least make sure it's covered by .gitignore.
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\user\Desktop\python\pace\service_account.json

# Optional tuning (defaults shown).
# POLL_INTERVAL_MS=5000
# JOB_EXPIRY_MINUTES=30
# LOGIN_TIMEOUT_MS=300000
# SEARCH_DELAY_MIN_MS=2000
# SEARCH_DELAY_MAX_MS=5000
# MAX_RESET_SUBUSER_ATTEMPTS=2
# BROWSER_PROFILE_DIR=.data/naukri-profile
# BROWSER_CHANNEL=chrome  # "chrome" (real installed Chrome, recommended) or "chromium"
# HEADLESS=false
